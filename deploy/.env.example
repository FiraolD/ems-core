# Copy to deploy/.env and fill in. Never commit the real .env file.

# Random value, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Host names or IP addresses people use to reach this server, comma separated.
ALLOWED_HOSTS=localhost

# Required only when served over HTTPS and the browser address differs from the host,
# for example https://hr.example.com
CSRF_TRUSTED_ORIGINS=

# true when users reach the app over HTTPS. Use false on a LAN without a certificate,
# otherwise login cookies are refused by the browser.
EMS_HTTPS=false

# Database
DB_NAME=ems
DB_USER=ems
DB_PASSWORD=

# Optional
# EMS_PORT=8000
# EMS_CLIENT_DIR=../clients/_template
# TIME_ZONE=Africa/Addis_Ababa
# LOG_LEVEL=INFO
